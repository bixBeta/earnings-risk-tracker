<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.earnings-risk-tracker.publish</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/fa286/Projects/earnings-risk-tracker/publish.sh</string>
    </array>

    <!-- Trigger when index.html changes. WatchPaths fires on mtime changes. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/fa286/Projects/earnings-risk-tracker/index.html</string>
    </array>

    <!-- launchd will not relaunch within this many seconds (debounces rapid writes). -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/earnings-risk-tracker.publish.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/earnings-risk-tracker.publish.err.log</string>
</dict>
</plist>
